<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SubgenAI.SerenityStar.AIServices</PackageId>
    <AssemblyName>SerenityStar.AIServices</AssemblyName>
    <RootNamespace>SerenityStar</RootNamespace>
    <Description>Serenity Star AI services for .NET: anonymizer and decisions. Does not require the agents package.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ai;sdk;serenity;serenitystar;anonymizer;decisions</PackageTags>
    <PackageReleaseNotes>
      Version 3.0.0-beta2 - AI Services Package Release

      NEW FEATURES:
      - New standalone package for Serenity Star AI services. It depends only on SubgenAI.SerenityStar.Core,
        so the agents package (SubgenAI.SerenityStar.SDK) is not required.
      - One interface per AI service, obtained from SerenityClient:
        * IAnonymizerClient - client.GetAnonymizerClient()
        * IDecisionClient - client.GetDecisionClient()
      - Dependency injection: services.AddSerenityStar(apiKey).AddSerenityStarAIServices() registers every interface.
      - Decisions accept a text or an ordered list of messages, function calls and function call outputs (e.g. an
        agent trace) as input, including images: DecisionInput.FromItems(...).
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SerenityStar.Core\SerenityStar.Core.csproj" />
  </ItemGroup>
</Project>
